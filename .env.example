# Copy to .env and fill in. .env is git-ignored: never commit real values.
# In CI/CD the same variables come from GitHub / AWS / Vercel secrets, one set per environment.

# ---------- API (apps/api) ----------
# loc | int | dev | stg | prd — without DATABASE_URL, only loc/int/test fall back to in-memory storage.
APP_ENV=loc
APP_VERSION=dev
PORT=3001
# Supabase: Project settings → Database → Connection string (transaction pooler, port 6543).
# Local Docker: postgres://pokewishlist:pokewishlist@localhost:5432/pokewishlist
DATABASE_URL=
# Migrations need a direct (session) connection, port 5432 on Supabase.
MIGRATION_DATABASE_URL=
# Comma-separated browser origins allowed to call the API; * allows any.
CORS_ORIGINS=http://localhost:3000

# ---------- Front (apps/web) ----------
NUXT_PUBLIC_API_BASE=http://localhost:3001
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000
NUXT_PUBLIC_APP_VERSION=dev
# SSG only: how many Pokémon pages `nuxt generate` prerenders (× 4 languages).
PRERENDER_POKEMON_LIMIT=151

# ---------- Integration tests ----------
# A throwaway database: tests truncate its tables.
TEST_DATABASE_URL=postgres://pokewishlist:pokewishlist@localhost:5432/pokewishlist_test
